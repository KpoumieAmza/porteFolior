---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Gemula from '../components/Gemula.astro';
import Parcours from '../components/Parcours.astro';
import Projets from '../components/Projets.astro';
import Competences from '../components/Competences.astro';
import Formation from '../components/Formation.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <Nav />
  <main id="contenu">
    <Hero />
    <Gemula />
    <Parcours />
    <Projets />
    <Competences />
    <Formation />
    <Contact />
  </main>
  <Footer />
</Base>
