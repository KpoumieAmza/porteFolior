---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import photo from '../assets/photo-amza.jpg';
import { identite } from '../data/cv';
---
<section id="top" class="hero grid-bg glow-top">
  <div class="container hero-in">
    <div class="txt">
      <p class="eyebrow">{identite.sousTitre}</p>
      <h1>{identite.nom}</h1>
      <p class="titre">{identite.titre}</p>
      <p class="muted resume">{identite.resume}</p>
      <div class="actions">
        <a class="btn btn-primary" href={identite.cv} download><Icon name="download" size={18} /> Télécharger mon CV</a>
        <a class="btn" href="#contact">Me contacter</a>
      </div>
    </div>
    <Image class="photo" src={photo} alt={`Portrait de ${identite.nom}`} width={360} height={360} loading="eager" />
  </div>
</section>
<style>
  .hero { padding-block: 4.5rem 5rem; overflow: hidden; }
  .hero-in { display: grid; grid-template-columns: 1fr auto; gap: 3rem; align-items: center; }
  h1 { font-size: clamp(2.2rem, 6vw, 3.6rem); }
  .titre { font-family: var(--font-titre); font-size: 1.3rem; color: var(--ac-tx); margin: .4rem 0 1.2rem; }
  .resume { max-width: 40rem; margin-bottom: 2rem; }
  .actions { display: flex; flex-wrap: wrap; gap: .8rem; }
  .photo { width: 18rem; height: 18rem; object-fit: cover; border-radius: 1.5rem; border: 1px solid var(--b2); box-shadow: 0 0 0 6px var(--s1), 0 0 60px rgba(255, 80, 0, .18); }
  @media (max-width: 760px) {
    .hero-in { grid-template-columns: 1fr; gap: 2rem; }
    .photo { order: -1; width: 11rem; height: 11rem; }
  }
</style>
